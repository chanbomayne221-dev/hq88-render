{
  "name": "hq88-telegram-bot",
  "version": "2.0.0",
  "description": "HQ88 VUA TRÒ CHƠI - Telegram bot (polling) chạy Render + PostgreSQL (pg)",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && cp -r sql dist/sql || xcopy /E /I /Y sql dist\\sql",
    "postinstall": "npm run build",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.13.1",
    "synckit": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/pg": "^8.11.10",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.2"
}
